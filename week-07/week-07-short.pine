//@version=6
strategy("j14-E1 adv short" , "" , true , max_boxes_count = 500 , max_lines_count = 500 , max_labels_count = 500 , initial_capital = 100000 , default_qty_type = strategy.fixed , default_qty_value = 1 , commission_type = strategy.commission.percent , commission_value = 0 , slippage = 0 , process_orders_on_close = true , calc_on_every_tick = false , pyramiding = 100 , margin_long = 0 , margin_short = 0)

tm = input.timeframe("60" , "Higher timeframe")
risk_reward = input.float(2.0 , "Risk : Reward" , minval = 0.1 , step = 0.1)

c_bull = color.green
c_bear = color.red
c_txt  = #2196f3
bg_tr  = 85
ms_w   = 1

var float hi_prc = high , var float lo_prc = low , var int hi_bar = time , var int lo_bar = time , var float bgr_op = open , var float bgr_cl = close
var box shd_bx = na , var box bdy_bx = na
var float hl = na , var float ll = na , var string mode = "nrm" , var string frst = ""

var lst_pvt = "" , var line inc = na , var line dec = na , var line old_ln = na
var pst_pvt = "" , var int pvt_ctr = na , var int lst_x = na , var float lst_y = na
var bool trig = false

bool isb = high < high[1] and low > low[1]
if mode == "nrm"
    hl := high[1] , ll := low[1]
    if isb
        mode := "osb"
else
    if high > hl or low < ll
        mode := "nrm"

[hi_lmt , lo_lmt] = request.security("" , tm , [hl , ll] , barmerge.gaps_off , barmerge.lookahead_on )

bool new_c = timeframe.change(tm)

if new_c

    if lst_pvt == "" and trig
        if frst == "hi"
            dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2) , lst_pvt := "bot"
        if frst == "lo"
            inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2) , lst_pvt := "top"
    pst_pvt := lst_pvt , pvt_ctr := 0

    if lst_pvt == "top"
        lst_x := inc.get_x2() , lst_y := inc.get_y2() , old_ln := inc
    else if lst_pvt == "bot"
        lst_x := dec.get_x2() , lst_y := dec.get_y2() , old_ln := dec
    hi_prc := high , hi_bar := time , lo_prc := low , lo_bar := time , bgr_op := open , bgr_cl := close
    frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")
    top_ = math.max(bgr_op , bgr_cl) , bot_ = math.min(bgr_op , bgr_cl) , bdy_clr = bgr_cl > bgr_op ? #4caf5033 : #ff525233
    shd_bx := box.new(bar_index , hi_prc , bar_index , lo_prc , #787b8626 , 1 , bgcolor = #787b8633)
    bdy_bx := box.new(bar_index , top_   , bar_index , bot_   , bdy_clr     , 1 , bgcolor = bdy_clr    )
else
    bgr_cl := close
    bdy_clr = bgr_cl > bgr_op ? #4caf5033 : #ff525233 , top_ = math.max(bgr_op , bgr_cl) , bot_ = math.min(bgr_op , bgr_cl)
    bdy_bx.set_border_color(bdy_clr) , bdy_bx.set_bgcolor(bdy_clr) , bdy_bx.set_top(top_) , bdy_bx.set_bottom(bot_)
    shd_bx.set_right(bar_index) , bdy_bx.set_right(bar_index)
    if high > hi_prc
        hi_prc := high , hi_bar := time , shd_bx.set_top   (hi_prc)
        frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")
    if low  < lo_prc
        lo_prc := low , lo_bar := time  , shd_bx.set_bottom(lo_prc)
        frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")

if not trig and (high > hi_lmt or low < lo_lmt)
    trig := true

if pvt_ctr == 0
    if high > hi_lmt and low < lo_lmt
        pvt_ctr := 2
        if pst_pvt == "top"
            if frst == "hi"
                inc.set_xy2(hi_bar , hi_prc)
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                lst_pvt := "bot"
            if frst == "lo"
                dec := line.new(lst_x  , lst_y  , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                lst_pvt := "top"
        else if pst_pvt == "bot"
            if frst == "hi"
                inc := line.new(lst_x  , lst_y  , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                lst_pvt := "bot"
            if frst == "lo"
                dec.set_xy2(lo_bar , lo_prc)
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                lst_pvt := "top"
    else if high > hi_lmt
        pvt_ctr := 1
        if pst_pvt == "top"
            inc.set_xy2(hi_bar , hi_prc)
        else if pst_pvt == "bot"
            inc := line.new(lst_x , lst_y , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
            lst_pvt := "top"
    else if low < lo_lmt
        pvt_ctr := 1
        if pst_pvt == "bot"
            dec.set_xy2(lo_bar , lo_prc)
        else if pst_pvt == "top"
            dec := line.new(lst_x , lst_y , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
            lst_pvt := "bot"

else if pvt_ctr == 1
    if high > hi_lmt and low < lo_lmt
        pvt_ctr := 2
        if lst_pvt == "top"
            if frst == "hi"
                inc.set_xy2(hi_bar , hi_prc)
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                lst_pvt := "bot"
            if frst == "lo"
                if pst_pvt == "top"
                    inc.set_xy2(lst_x , lst_y)
                    dec := line.new(lst_x  , lst_y  , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                    inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                else if pst_pvt == "bot"
                    dec.set_xy2(lo_bar , lo_prc)
                    inc.set_xy1(lo_bar , lo_prc) , inc.set_xy2(hi_bar , hi_prc)
                lst_pvt := "top"
        else if lst_pvt == "bot"
            if frst == "lo"
                dec.set_xy2(lo_bar , lo_prc)
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                lst_pvt := "top"
            if frst == "hi"
                if pst_pvt == "bot"
                    dec.set_xy2(lst_x , lst_y)
                    inc := line.new(lst_x  , lst_y  , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                    dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                else if pst_pvt == "top"
                    inc.set_xy2(hi_bar , hi_prc)
                    dec.set_xy1(hi_bar , hi_prc) , dec.set_xy2(lo_bar , lo_prc)
                lst_pvt := "bot"
    else if high > hi_lmt
        if lst_pvt == "top"
            inc.set_xy2(hi_bar , hi_prc)
        else if lst_pvt == "bot"
            dec.set_xy2(lo_bar , lo_prc)
            inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
            lst_pvt := "top"
            pvt_ctr := 2
    else if low < lo_lmt
        if lst_pvt == "bot"
            dec.set_xy2(lo_bar , lo_prc)
        else if lst_pvt == "top"
            inc.set_xy2(hi_bar , hi_prc)
            dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
            lst_pvt := "bot"
            pvt_ctr := 2

else if pvt_ctr > 1
    if pst_pvt == "top"
        if frst == "hi"
            if lst_pvt == "top"
                old_ln.set_xy2(hi_bar , hi_prc)
                inc.delete()
                inc := old_ln
                lst_pvt := "bot"
            inc.set_xy2(hi_bar , hi_prc)
            dec.set_xy1(hi_bar , hi_prc) , dec.set_xy2(lo_bar , lo_prc)
        else
            if lst_pvt == "bot"
                old_ln.set_xy2(lst_x , lst_y)
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2)
                lst_pvt := "top"
            dec.set_xy1(lst_x , lst_y) , dec.set_xy2(lo_bar , lo_prc)
            inc.set_xy1(lo_bar , lo_prc) , inc.set_xy2(hi_bar , hi_prc)
    else if pst_pvt == "bot"
        if frst == "lo"
            if lst_pvt == "bot"
                old_ln.set_xy2(lo_bar , lo_prc)
                dec.delete()
                dec := old_ln
                lst_pvt := "top"
            dec.set_xy2(lo_bar , lo_prc)
            inc.set_xy1(lo_bar , lo_prc) , inc.set_xy2(hi_bar , hi_prc)
        else
            if lst_pvt == "top"
                old_ln.set_xy2(lst_x , lst_y)
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2)
                lst_pvt := "bot"
            inc.set_xy1(lst_x , lst_y) , inc.set_xy2(hi_bar , hi_prc)
            dec.set_xy1(hi_bar , hi_prc) , dec.set_xy2(lo_bar , lo_prc)


TOP      =  1
BOTTOM   = -1
BULL     =  1
BEAR     = -1
NO_TREND =  0

STAGE_IDLE         = 0
STAGE_WAIT_LEG_END = 1
STAGE_MAJORS_KNOWN = 2

bool bar_closed = barstate.isconfirmed


var array<int>   piv_time  = array.new<int>()
var array<float> piv_price = array.new<float>()
var array<int>   piv_type  = array.new<int>()
var int final_count = 0
var int hour_start_count = 0      // pivots that existed when the current higher-timeframe candle started

if new_c
    final_count := math.max(piv_time.size() - 1 , 0)
    hour_start_count := piv_time.size()

line last_zz_line = lst_pvt == "top" ? inc : lst_pvt == "bot" ? dec : na

if not na(last_zz_line)
    int   line_start_time  = last_zz_line.get_x1()
    float line_start_price = last_zz_line.get_y1()
    int   line_end_time    = last_zz_line.get_x2()
    float line_end_price   = last_zz_line.get_y2()
    int   line_end_type    = lst_pvt == "top" ? TOP : BOTTOM
    int   line_start_type  = -line_end_type

    line  prev_zz_line = lst_pvt == "top" ? dec : inc
    bool  connected    = false
    int   tail_time    = line_start_time
    float tail_price   = line_start_price
    int   tail_type    = line_start_type
    if not na(prev_zz_line)
        connected := prev_zz_line.get_x2() == line_start_time and prev_zz_line.get_y2() == line_start_price
        if connected
            tail_time  := prev_zz_line.get_x1()
            tail_price := prev_zz_line.get_y1()
            tail_type  := line_end_type

    while piv_time.size() > 0 and (piv_time.last() > tail_time or (piv_time.last() == tail_time and piv_type.last() != tail_type))
        piv_time.pop()
        piv_price.pop()
        piv_type.pop()

    if piv_time.size() > 0 and piv_type.last() == tail_type
        if piv_time.last() != tail_time or piv_price.last() != tail_price
            int last_idx = piv_time.size() - 1
            piv_time.set(last_idx , tail_time)
            piv_price.set(last_idx , tail_price)
    else
        piv_time.push(tail_time)
        piv_price.push(tail_price)
        piv_type.push(tail_type)

    if connected
        piv_time.push(line_start_time)
        piv_price.push(line_start_price)
        piv_type.push(line_start_type)

    piv_time.push(line_end_time)
    piv_price.push(line_end_price)
    piv_type.push(line_end_type)

    if piv_time.size() > 300
        piv_time.shift()
        piv_price.shift()
        piv_type.shift()
        final_count := math.max(final_count - 1 , 0)
        hour_start_count := math.max(hour_start_count - 1 , 0)

final_count := math.min(final_count , math.max(piv_time.size() - 1 , 0))
hour_start_count := math.min(hour_start_count , piv_time.size())

int   piv_count = piv_time.size()
int   dev_type  = 0
float dev_price = na
if piv_count > 0
    dev_type  := piv_type.get(piv_count - 1)
    dev_price := piv_price.get(piv_count - 1)


var int trend = NO_TREND

if trend == NO_TREND and final_count >= 4
    for last_i = math.max(3 , final_count - 3) to final_count - 1
        if trend == NO_TREND
            float p1 = piv_price.get(last_i - 3)
            float p2 = piv_price.get(last_i - 2)
            float p3 = piv_price.get(last_i - 1)
            float p4 = piv_price.get(last_i)
            bool  has_next_final = last_i + 1 <= final_count - 1
            if piv_type.get(last_i) == BOTTOM
                bool top2_broken = has_next_final ? piv_price.get(last_i + 1) > p3 : (high > p3 or (dev_type == TOP and dev_price > p3))
                if top2_broken and p1 < p3 and p2 < p4
                    trend := BULL
            else
                bool bottom2_broken = has_next_final ? piv_price.get(last_i + 1) < p3 : (low < p3 or (dev_type == BOTTOM and dev_price < p3))
                if bottom2_broken and p1 > p3 and p2 > p4
                    trend := BEAR


var array<int>   org_time  = array.new<int>()
var array<float> org_price = array.new<float>()
var array<int>   org_type  = array.new<int>()
var array<bool>  org_used  = array.new<bool>()
var int last_origin_low_time  = 0
var int last_origin_high_time = 0

add_origin(int piv_idx , int kind) =>
    org_time.push(piv_time.get(piv_idx))
    org_price.push(piv_price.get(piv_idx))
    org_type.push(kind)
    org_used.push(false)
    true

if final_count >= 2
    for i = math.max(1 , final_count - 5) to final_count - 1
        int type_i = piv_type.get(i)
        if type_i == BOTTOM and piv_type.get(i - 1) == TOP and piv_time.get(i) > last_origin_low_time
            float prev_top = piv_price.get(i - 1)
            bool  prev_top_broken = i + 1 <= final_count - 1 ? piv_price.get(i + 1) > prev_top : (high > prev_top or (dev_type == TOP and dev_price > prev_top))
            if prev_top_broken
                last_origin_low_time := piv_time.get(i)
                add_origin(i , BOTTOM)
        else if type_i == TOP and piv_type.get(i - 1) == BOTTOM and piv_time.get(i) > last_origin_high_time
            float prev_bottom = piv_price.get(i - 1)
            bool  prev_bottom_broken = i + 1 <= final_count - 1 ? piv_price.get(i + 1) < prev_bottom : (low < prev_bottom or (dev_type == BOTTOM and dev_price < prev_bottom))
            if prev_bottom_broken
                last_origin_high_time := piv_time.get(i)
                add_origin(i , TOP)

if org_time.size() > 100
    org_time.shift()
    org_price.shift()
    org_type.shift()
    org_used.shift()


var array<line>  ms_lines  = array.new<line>()
var array<label> ms_labels = array.new<label>()

var int   choch_stage        = STAGE_IDLE
var int   choch_origin_time  = 0
var float choch_origin_price = na
var float leg_start_price    = na
var bool  leg_start_open     = false
var float major1_price       = na
var int   major2_time        = 0
var float major2_price       = na
var float leg_ext_price      = na
var int   leg_ext_time       = 0
var bool  leg_pull_ready     = false
var int   valid_after_time   = 0
var int   bos_line_end_time  = 0

draw_level_line(int x1 , float y , int x2 , color c , string txt) =>
    ms_lines.push(line.new(x1 , y , x2 , y , xloc = xloc.bar_time , color = c , width = ms_w))
    ms_labels.push(label.new(math.round((x1 + x2) / 2) , y , txt , xloc = xloc.bar_time , style = label.style_none , textcolor = c_txt , size = size.small))
    if ms_lines.size() > 60
        line  old_line  = ms_lines.shift()
        label old_label = ms_labels.shift()
        old_line.delete()
        old_label.delete()
    true

if trend != NO_TREND and piv_count >= 3
    int   leg_dir     = -trend
    bool  high_first  = frst == "hi"
    bool  start_open  = dev_type == -leg_dir
    float start_price = start_open ? dev_price : piv_price.get(piv_count - 2)

    bool choch_hit  = false
    int  origin_idx = -1
    if choch_stage == STAGE_IDLE and org_time.size() > 0
        for i = org_time.size() - 1 to 0
            if org_type.get(i) == leg_dir and not org_used.get(i) and org_time.get(i) > valid_after_time
                origin_idx := i
                break
        if origin_idx >= 0
            choch_hit := leg_dir == -1 ? low < org_price.get(origin_idx) : high > org_price.get(origin_idx)

    if choch_hit
        choch_origin_time  := org_time.get(origin_idx)
        choch_origin_price := org_price.get(origin_idx)
        leg_start_price    := start_price
        leg_start_open     := start_open
        choch_stage        := STAGE_WAIT_LEG_END
        leg_ext_price      := leg_dir == -1 ? low : high
        leg_ext_time       := time
        leg_pull_ready     := false
        if bar_closed
            draw_level_line(choch_origin_time , choch_origin_price , time , leg_dir == -1 ? c_bear : c_bull , "choch")

    if (choch_hit or choch_stage != STAGE_IDLE) and org_time.size() > 0
        for i = 0 to org_time.size() - 1
            if org_type.get(i) == leg_dir and not org_used.get(i) and (leg_dir == -1 ? low < org_price.get(i) : high > org_price.get(i))
                org_used.set(i , true)

    if choch_stage != STAGE_IDLE and not choch_hit
        bool bos_hit      = false
        bool choch_failed = false
        int  bos_end_time = time

        if choch_stage == STAGE_WAIT_LEG_END
            if not leg_start_open and (leg_dir == -1 ? high > leg_start_price : low < leg_start_price)
                choch_failed := true
            else if leg_start_open
                leg_start_price := start_price
                leg_start_open  := start_open

        // major 2 = the extreme of the CHoCH leg (lowest low for a down leg, highest high for an up leg), tracked bar by bar
        // from the CHoCH bar. The leg is over when a pullback pivot (opposite type) was already printed after that extreme
        // at the end of the PREVIOUS bar (leg_pull_ready). A pivot printed on the same bar as a new extreme is not a pullback,
        // it only belongs to the same candle. The latch uses the extreme of the previous bars, so the bar that follows a
        // pullback and breaks the extreme is a BOS.
        if choch_stage == STAGE_WAIT_LEG_END and not choch_failed
            int maj1_idx = -1
            if leg_pull_ready
                for j = piv_count - 1 to 0
                    if piv_time.get(j) < leg_ext_time and piv_type.get(j) == -leg_dir
                        maj1_idx := j
                        break
            if leg_pull_ready and maj1_idx >= 0
                major1_price   := piv_price.get(maj1_idx)
                major2_time    := leg_ext_time
                major2_price   := leg_ext_price
                leg_pull_ready := false
                choch_stage    := STAGE_MAJORS_KNOWN
                // pivots after major 2 (also the ones still forming) may already have broken it or major 1;
                // bos_end_time is then the time of that pivot, not the current bar
                for n = 0 to piv_count - 1
                    if piv_time.get(n) > major2_time and not bos_hit and not choch_failed
                        if piv_type.get(n) == -leg_dir and (leg_dir == -1 ? piv_price.get(n) > major1_price : piv_price.get(n) < major1_price)
                            choch_failed := true
                        else if piv_type.get(n) == leg_dir and (leg_dir == -1 ? piv_price.get(n) < major2_price : piv_price.get(n) > major2_price)
                            bos_hit      := true
                            bos_end_time := piv_time.get(n)
            else
                if (leg_dir == -1 ? low < leg_ext_price : high > leg_ext_price)
                    leg_ext_price := leg_dir == -1 ? low : high
                    leg_ext_time  := time
                leg_pull_ready := false
                for j = piv_count - 1 to 0
                    if piv_time.get(j) <= leg_ext_time
                        break
                    if piv_type.get(j) == -leg_dir
                        leg_pull_ready := true
                        break

        if choch_stage == STAGE_MAJORS_KNOWN and not bos_hit and not choch_failed
            bos_hit      := leg_dir == -1 ? low < major2_price : high > major2_price
            choch_failed := leg_dir == -1 ? high > major1_price : low < major1_price
            if bos_hit and choch_failed
                bos_hit      := leg_dir == -1 ? not high_first : high_first
                choch_failed := not bos_hit

        if bos_hit
            if bar_closed
                draw_level_line(major2_time , major2_price , bos_end_time , leg_dir == -1 ? c_bear : c_bull , "bos")
            trend            := leg_dir
            valid_after_time := major2_time
            bos_line_end_time := bos_end_time
            choch_stage      := STAGE_IDLE
        else if choch_failed
            choch_stage := STAGE_IDLE


bgcolor(trend == BULL ? color.new(c_bull , bg_tr) : trend == BEAR ? color.new(c_bear , bg_tr) : na)


// ---- order blocks (short side) ----
// A bearish BOS turns the unused tops of the BOS range into supply order blocks.
// Zone of an order block = the chart candle that printed the top (its low .. its high).

OB_ACTIVE  = 0
OB_ENTERED = 1
OB_INVALID = 2

ob_alpha      = 80      // band transparency
ob_max        = 100     // order blocks kept in memory
ob_wait_final = true    // true : build the order blocks once every top of the BOS range is final (no repaint, usually on the BOS bar)
                        // false: build them on the BOS bar (tops that are still forming are missed)
risk_percent  = 1.0     // % of equity risked per position


// other side of the chart candle that printed each higher-tf high / low
// (same rule as the candle code above: the first bar that makes the new extreme wins)
var map<int , float> bar_low_at_htf_high = map.new<int , float>()      // time of a higher-tf high -> low of that chart candle
var map<int , float> bar_high_at_htf_low = map.new<int , float>()      // time of a higher-tf low  -> high of that chart candle (long side)

var float htf_high         = na
var int   htf_high_time    = na
var float htf_high_bar_low = na
var float htf_low          = na
var int   htf_low_time     = na
var float htf_low_bar_high = na

if new_c
    if not na(htf_high_time)
        bar_low_at_htf_high.put(htf_high_time , htf_high_bar_low)
        bar_high_at_htf_low.put(htf_low_time , htf_low_bar_high)
    htf_high := high , htf_high_time := time , htf_high_bar_low := low
    htf_low  := low  , htf_low_time  := time , htf_low_bar_high  := high
else
    if high > htf_high
        htf_high := high , htf_high_time := time , htf_high_bar_low := low
    if low < htf_low
        htf_low := low , htf_low_time := time , htf_low_bar_high := high


var array<float> ob_top    = array.new<float>()
var array<float> ob_bottom = array.new<float>()
var array<int>   ob_time   = array.new<int>()       // time of the chart candle
var array<int>   ob_bar    = array.new<int>()       // bar the order block was created on (entries start on the next bar)
var array<int>   ob_state  = array.new<int>()
var array<box>   ob_box    = array.new<box>()

add_order_block(float top_price , float bottom_price , int candle_time) =>
    ob_top.push(top_price)
    ob_bottom.push(bottom_price)
    ob_time.push(candle_time)
    ob_bar.push(bar_index)
    ob_state.push(OB_ACTIVE)
    ob_box.push(box.new(candle_time , top_price , time , bottom_price , xloc = xloc.bar_time , extend = extend.right , border_color = na , bgcolor = color.new(c_bear , ob_alpha)))
    if ob_top.size() > ob_max
        ob_top.shift()
        ob_bottom.shift()
        ob_time.shift()
        ob_bar.shift()
        ob_state.shift()
        ob_box.shift()          // forget it, but leave the band on the chart
    true

// an entered or broken order block keeps its band on the chart, it just stops growing
end_order_block(int idx , int new_state) =>
    ob_state.set(idx , new_state)
    box band = ob_box.get(idx)
    band.set_extend(extend.none)
    band.set_right(time)
    true

// pivots the order blocks may use: those that existed when the current higher-timeframe candle started and already have a
// later pivot (a pivot that is still the last one, or was created in this candle, can still move or be rebuilt)
int ob_scan_top = math.min(math.max(final_count , hour_start_count) - 1 , piv_count - 2)

// tops inside the BOS range that no later top (inside the range) has beaten; major 1 is outside the range
build_order_blocks(int range_start , int range_end , int scan_top) =>
    float highest_later_top = na
    if scan_top >= 0
        for i = scan_top to 0
            if piv_time.get(i) <= range_start
                break
            if piv_type.get(i) == TOP and piv_time.get(i) < range_end
                float top_price  = piv_price.get(i)
                float low_of_bar = bar_low_at_htf_high.get(piv_time.get(i))
                if (na(highest_later_top) or top_price >= highest_later_top) and not na(low_of_bar)
                    add_order_block(top_price , low_of_bar , piv_time.get(i))
                highest_later_top := na(highest_later_top) ? top_price : math.max(highest_later_top , top_price)
    true


var int  prev_trend      = NO_TREND
var bool ob_pending      = false
var int  ob_range_start  = 0
var int  ob_range_end    = 0

bool bear_bos = prev_trend == BULL and trend == BEAR

// range of the BOS line: from major 2 to where the break happened
if bear_bos
    ob_range_start := valid_after_time
    ob_range_end   := bos_line_end_time
    if ob_wait_final
        ob_pending := true
    else
        build_order_blocks(ob_range_start , ob_range_end , ob_scan_top)

// wait until every top before the end of the range is final, then build
if ob_pending
    if trend != BEAR
        ob_pending := false
    else
        // only the top pivots before the end of the range have to be final (they decide the set); a forming bottom
        // pivot cannot add or remove an order block, so the build usually happens on the BOS bar itself
        bool tops_final = true
        if piv_count - 1 >= ob_scan_top + 1
            for i = ob_scan_top + 1 to piv_count - 1
                if piv_time.get(i) >= ob_range_end
                    break
                if piv_type.get(i) == TOP
                    tops_final := false
                    break
        if tops_final
            build_order_blocks(ob_range_start , ob_range_end , ob_scan_top)
            ob_pending := false

// the bands belong to the bearish trend: when it ends they stop growing
if prev_trend == BEAR and trend != BEAR and ob_top.size() > 0
    for i = 0 to ob_top.size() - 1
        if ob_state.get(i) == OB_ACTIVE
            end_order_block(i , OB_INVALID)


// ---- entries and exits (short side) ----
// An order block is hit when the HIGH of a chart candle lands inside its zone; a high above the zone breaks it instead.
// Entry = close of the hit candle. SL = far side (top) of the zone, with overlapping zones the highest top. TP = entry - risk_reward x risk.
// The SL is a real stop order (exact price), the TP is checked by hand from the next bar on, so a candle that touches both is a loss.

var int          pos_counter    = 0
var array<string> pos_ids       = array.new<string>()
var array<float>  pos_tp        = array.new<float>()
var array<line>   pos_entry_line = array.new<line>()
var array<line>   pos_sl_line   = array.new<line>()
var array<line>   pos_tp_line   = array.new<line>()

trade_is_open(string key) =>
    bool found = false
    if strategy.opentrades > 0
        for t = 0 to strategy.opentrades - 1
            if strategy.opentrades.entry_id(t) == key
                found := true
                break
    found

stop_line(line ln) =>
    ln.set_extend(extend.none)
    ln.set_x2(bar_index)
    true

// manage the open positions (a position opened on this bar is added below)
if pos_ids.size() > 0
    for i = pos_ids.size() - 1 to 0
        string pos_key    = pos_ids.get(i)
        bool   still_open = trade_is_open(pos_key)
        bool   tp_hit     = still_open and low <= pos_tp.get(i)
        if tp_hit
            strategy.close(pos_key , comment = "TP")
        if not still_open or tp_hit
            stop_line(pos_entry_line.get(i))
            stop_line(pos_sl_line.get(i))
            stop_line(pos_tp_line.get(i))
            pos_ids.remove(i)
            pos_tp.remove(i)
            pos_entry_line.remove(i)
            pos_sl_line.remove(i)
            pos_tp_line.remove(i)

// order blocks touched by this candle (an order block created on this bar can only be hit from the next bar on)
float hit_sl  = na
bool  any_hit = false
if ob_top.size() > 0
    for i = 0 to ob_top.size() - 1
        if ob_state.get(i) == OB_ACTIVE and bar_index > ob_bar.get(i)
            if high > ob_top.get(i)
                end_order_block(i , OB_INVALID)
            else if high >= ob_bottom.get(i)
                any_hit := true
                hit_sl  := na(hit_sl) ? ob_top.get(i) : math.max(hit_sl , ob_top.get(i))

if any_hit and hit_sl > close and strategy.equity > 0
    float risk_dist = hit_sl - close
    float tp_price  = close - risk_reward * risk_dist
    string pos_name = "S" + str.tostring(pos_counter)
    pos_counter := pos_counter + 1

    strategy.entry(pos_name , strategy.short , qty = strategy.equity * risk_percent / 100 / risk_dist)
    strategy.exit("X" + pos_name , from_entry = pos_name , stop = hit_sl)

    // every zone this candle landed in is used up
    for i = 0 to ob_top.size() - 1
        if ob_state.get(i) == OB_ACTIVE and bar_index > ob_bar.get(i) and high >= ob_bottom.get(i)
            end_order_block(i , OB_ENTERED)

    pos_ids.push(pos_name)
    pos_tp.push(tp_price)
    pos_entry_line.push(line.new(bar_index , close    , bar_index + 1 , close    , extend = extend.right , color = color.yellow))
    pos_sl_line.push(line.new(bar_index , hit_sl   , bar_index + 1 , hit_sl   , extend = extend.right , color = c_bear))
    pos_tp_line.push(line.new(bar_index , tp_price , bar_index + 1 , tp_price , extend = extend.right , color = c_bull))

prev_trend := trend
