//         else if lst_pvt == "bot"


plotshape(frst == "hi")

plot(hi_lmt , "" , color.white , 1 , plot.style_steplinebr )
plot(lo_lmt , "" , color.white , 1 , plot.style_steplinebr )

plot(hi_prc , "" , color.yellow , 1 , plot.style_steplinebr )
plot(lo_prc , "" , color.yellow , 1 , plot.style_steplinebr )
