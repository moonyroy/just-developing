//@version=6
indicator("j14-E1 adv" , "" , true , max_boxes_count = 500 , max_lines_count = 500 , max_labels_count = 500)

var float hi_prc = high , var float lo_prc = low , var int hi_bar = time , var int lo_bar = time , var float bgr_op = open , var float bgr_cl = close // var float hi_lmt = na , var float lo_lmt = na
var box shd_bx = na , var box bdy_bx = na , var float hl = na , var float ll = na , isb = high < high[1] and low > low[1] , var mode = "nrm" , var frst = ""

var lst_pvt = "" , var line inc = na , var line dec = na
var pst_pvt = "" , var pvt = "" , var int pvt_ctr = na , var int lst_x = na , var float lst_y = na , var int x = na , var float y = na


if mode == "nrm"
    hl := high[1] , ll := low[1]
    if isb
        mode := "osb"
else
    if high > hl or low < ll
        mode := "nrm"

[hi_lmt , lo_lmt] = request.security("" , "60" , [hl , ll] , barmerge.gaps_off , barmerge.lookahead_on )

cndl_dsp = input.bool(true , "cadle display")

if timeframe.change("60")
    if lst_pvt == ""
        if frst == "hi"
            dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2) , lst_pvt := "bot"
        if frst == "lo"
            inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2) , lst_pvt := "top"
    pst_pvt := lst_pvt , pvt_ctr := 0 , lst_x := lst_pvt == "top" ? inc.get_x2() : dec.get_x2() , lst_y := lst_pvt == "top" ? inc.get_y2() : dec.get_y2()
    hi_prc := high , hi_bar := time , lo_prc := low , lo_bar := time , bgr_op := open , bgr_cl := close
    frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")
    top_ = math.max(bgr_op , bgr_cl) , bot_ = math.min(bgr_op , bgr_cl) , bdy_clr = bgr_cl > bgr_op ? #4caf5033 : #ff525233
    shd_bx := box.new(bar_index , hi_prc , bar_index+59 , lo_prc , #787b8626 , 1 , bgcolor = #787b8633)
    bdy_bx := box.new(bar_index , top_   , bar_index+59 , bot_   , bdy_clr     , 1 , bgcolor = bdy_clr    )
else
    bgr_cl := close
    bdy_clr = bgr_cl > bgr_op ? #4caf5033 : #ff525233 , top_ = math.max(bgr_op , bgr_cl) , bot_ = math.min(bgr_op , bgr_cl)
    bdy_bx.set_border_color(bdy_clr) , bdy_bx.set_bgcolor(bdy_clr) , bdy_bx.set_top(top_) , bdy_bx.set_bottom(bot_)
    if high > hi_prc
        hi_prc := high , hi_bar := time , shd_bx.set_top   (hi_prc)
        frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")
    if low  < lo_prc
        lo_prc := low , lo_bar := time  , shd_bx.set_bottom(lo_prc)
        frst := hi_bar < lo_bar ? "hi" : lo_bar < hi_bar ? "lo" : (high-open < open-low ? "hi" : "lo")


//||||||||||||||||||||||||||||||||||||||||||||||||||||||| ((   ZIGZAG   )) ||||||||||||||||||||||||||||||||||||||||||||||||||||||

if pvt_ctr == 0
    if high > hi_lmt and low < lo_lmt
        pvt_ctr := 2
        if lst_pvt == "top"
            if frst == "hi"
                inc.set_y2(hi_prc) , inc.set_x2(hi_bar) ,
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2) , lst_pvt := "bot"
            if frst == "lo"
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2) , lst_pvt := "bot"
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2) , lst_pvt := "top"
        else if lst_pvt == "bot"
            if frst == "hi"
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2) , lst_pvt := "top"
                dec := line.new(hi_bar , hi_prc , lo_bar , lo_prc , xloc.bar_time , color = color.orange , width = 2) , lst_pvt := "bot"
            if frst == "lo"
                dec.set_y2(lo_prc) , dec.set_x2(lo_bar) ,
                inc := line.new(lo_bar , lo_prc , hi_bar , hi_prc , xloc.bar_time , color = color.aqua   , width = 2) , lst_pvt := "top"
    // else if high > hi_lmt
